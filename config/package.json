{
  "name": "qbit-desktop",
  "version": "1.0.0",
  "description": "QBIT — Asistente personal para Windows",
  "private": true,
  "main": "../windows/electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check ../windows/electron/main.cjs && node --check ../windows/electron/preload.cjs && node --check ../app.js && node --check ../desktop-agent.js && node --check ../mascot.js && node --check ../windows/electron/mascot-window.js",
    "dist": "electron-builder --projectDir .. --config package.json --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "@capacitor/core": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  },
  "build": {
    "appId": "com.gotti23b.qbit",
    "productName": "QBIT",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "index.html",
      "app.js",
      "desktop-agent.js",
      "styles.css",
      "mascot.css",
      "mascot.js",
      "qbit-icon.ico",
      "qbit-icon.svg",
      "windows/electron/**/*",
      "electron/**/*",
      "!README.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.2",
    "onnxruntime-node": "1.22.0"
  }
}
